                        local dist = (tHRP.Position - myHRP.Position).Magnitude
                        if dist <= 4.5 then
                            local dir = (tHRP.Position - myHRP.Position).Unit
                            if dir.Magnitude == 0 or dir ~= dir then dir = Vector3.new(0, 1, 0) end
                            
                            myHRP.Velocity = (dir * 1200) + Vector3.new(0, 800, 0)
                            myHRP.RotVelocity = Vector3.new(math.random(-1000,1000), math.random(1500,3000), math.random(-1000,1000))
                            myHRP.CFrame = tHRP.CFrame * CFrame.new(0, 0, math.sin(tick() * 50) * 0.2)

