                    lbl.Size = UDim2.new(1, 0, 0, 22)
                    lbl.BackgroundTransparency = 1
                    lbl.TextColor3 = Color3.fromRGB(255, 80, 80)
                    lbl.TextStrokeTransparency = 0
                    lbl.Font = Enum.Font.SourceSansBold
                    lbl.TextSize = 12

                    local hpText = Instance.new("TextLabel", bb)
                    hpText.Name = "HPText"
                    hpText.Size = UDim2.new(1, 0, 0, 15)
                    hpText.Position = UDim2.new(0, 0, 0, 22)
                    hpText.BackgroundTransparency = 1
                    hpText.TextColor3 = Color3.fromRGB(255, 255, 255)
                    hpText.TextStrokeTransparency = 0
                    hpText.Font = Enum.Font.SourceSans
                    hpText.TextSize = 10

                    local barBg = Instance.new("Frame", bb)
                    barBg.Name = "HPBarBg"
                    barBg.Size = UDim2.new(0.8, 0, 0, 6)
                    barBg.Position = UDim2.new(0.1, 0, 0, 38)
                    barBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                    barBg.BorderSizePixel = 0
                    Instance.new("UICorner", barBg).CornerRadius = UDim.new(0, 3)

                    local barFill = Instance.new("Frame", barBg)
                    barFill.Name = "HPBarFill"
                    barFill.Size = UDim2.new(1, 0, 1, 0)
                    barFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
                    barFill.BorderSizePixel = 0
                    Instance.new("UICorner", barFill).CornerRadius = UDim.new(0, 3)
                end

                bb.Adornee = head
                local dist = myHRP and math.floor((myHRP.Position - targetHRP.Position).Magnitude) or 0
                local lbl = bb:FindFirstChild("NameLabel")
                if lbl then lbl.Text = string.format("%s (@%s)\n[%d m]", p.DisplayName, p.Name, dist) end

                local hpText = bb:FindFirstChild("HPText")
                local barBg = bb:FindFirstChild("HPBarBg")
                local barFill = barBg and barBg:FindFirstChild("HPBarFill")
                
                if targetHum then
                    local curHP = math.clamp(targetHum.Health, 0, targetHum.MaxHealth)
                    local maxHP = targetHum.MaxHealth > 0 and targetHum.MaxHealth or 100
                    local ratio = curHP / maxHP

                    if hpText then hpText.Text = string.format("HP: %d / %d", math.floor(curHP), math.floor(maxHP)) end
                    if barFill then
                        barFill.Size = UDim2.new(ratio, 0, 1, 0)
                        barFill.BackgroundColor3 = Color3.fromHSV(ratio * 0.3, 0.9, 0.9)
                    end
                end
            elseif bb then
                bb:Destroy()
            end
        end
    end
end)

