-- 🦅 4.2 บินอิสระ
CreateToggleButton(TabMove, "🦅 4.2 บินอิสระ (หันตามกล้อง + เคลื่อนที่อิสระ)", function(e)
    FlyingEnabled = e
    local hrp, hum = GetHRP(LocalPlayer), GetHum(LocalPlayer)
    
    if FlyingEnabled and hrp then
        if hum then hum.PlatformStand = true end

        local bv = hrp:FindFirstChild("GhostFlyBV") or Instance.new("BodyVelocity")
        bv.Name = "GhostFlyBV"
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = hrp

        local bg = hrp:FindFirstChild("GhostFlyBG") or Instance.new("BodyGyro")
        bg.Name = "GhostFlyBG"
        bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        bg.P = 9e4
        bg.Parent = hrp

        if FlyConn then FlyConn:Disconnect() end
        FlyConn = RunService.RenderStepped:Connect(function()
            local currentHRP, currentHum = GetHRP(LocalPlayer), GetHum(LocalPlayer)
            if not FlyingEnabled or not currentHRP or not currentHRP:FindFirstChild("GhostFlyBV") then
                if bv then bv:Destroy() end
                if bg then bg:Destroy() end
                if currentHum then 
                    currentHum.PlatformStand = false 
                    currentHum:ChangeState(Enum.HumanoidStateType.GettingUp) 
                end
                if FlyConn then FlyConn:Disconnect() FlyConn = nil end
                return
            end

            currentHum.PlatformStand = true
            bg.CFrame = Camera.CFrame

            local camCF = Camera.CFrame
            local moveVector = Vector3.new(0, 0, 0)

            local forward = (UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.S) and 1 or 0)
            local right = (UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
            local up = ((UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E)) and 1 or 0) - ((UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.Q)) and 1 or 0)

            if forward ~= 0 or right ~= 0 or up ~= 0 then
                moveVector = (camCF.LookVector * forward) + (camCF.RightVector * right) + (camCF.UpVector * up)
            end

            if moveVector.Magnitude > 0 then
                bv.Velocity = moveVector.Unit * FlySpeed
            else
                bv.Velocity = Vector3.new(0, 0, 0)
            end
        end)
    else
        if hum then 
            hum.PlatformStand = false 
            hum:ChangeState(Enum.HumanoidStateType.GettingUp) 
        end
        if hrp then
            if hrp:FindFirstChild("GhostFlyBV") then hrp.GhostFlyBV:Destroy() end
            if hrp:FindFirstChild("GhostFlyBG") then hrp.GhostFlyBG:Destroy() end
        end
        if FlyConn then FlyConn:Disconnect() FlyConn = nil end
    end
end)

