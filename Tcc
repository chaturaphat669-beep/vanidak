CreateToggleButton(TabTroll, "🛸 21. เปิด/ปิด บินรอบผู้เล่น (Smooth Orbit)", function(e)
    OrbitEnabled = e
    if OrbitEnabled then
        local targetIdx = 1
        if OrbitConn then OrbitConn:Disconnect() end
        
        OrbitConn = RunService.Heartbeat:Connect(function(dt)
            if not OrbitEnabled then
                if OrbitConn then OrbitConn:Disconnect() OrbitConn = nil end
                return
            end

            local targets = GetTargets(OrbitTarget)
            local curHRP = GetHRP(LocalPlayer)
            local curHum = GetHum(LocalPlayer)

            if #targets == 0 or not curHRP or not curHRP.Parent then return end

            if curHum then
                curHum.PlatformStand = false
                curHum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
            end

            if LocalPlayer.Character then
                for _, p in pairs(LocalPlayer.Character:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
            end

            local currentTarget = targets[targetIdx]
            local tHRP = GetHRP(currentTarget)

            if tHRP then
                OrbitAngle = OrbitAngle + (dt * OrbitSpeed)
                if OrbitAngle > 1e12 or OrbitAngle < -1e12 then 
                    OrbitAngle = OrbitAngle % (math.pi * 2) 
                end

                local offsetX = math.cos(OrbitAngle) * OrbitDistance
                local offsetZ = math.sin(OrbitAngle) * OrbitDistance
                local targetPos = tHRP.Position + Vector3.new(offsetX, 0, offsetZ)

                curHRP.Velocity = Vector3.zero
                curHRP.RotVelocity = Vector3.zero
                curHRP.CFrame = CFrame.new(targetPos, tHRP.Position)
            end

            targetIdx = (targetIdx % #targets) + 1
        end)
    else
        if OrbitConn then OrbitConn:Disconnect() OrbitConn = nil end
        local curHum = GetHum(LocalPlayer)
        if curHum then curHum:ChangeState(Enum.HumanoidStateType.GettingUp) end
        if LocalPlayer.Character then
            for _, p in pairs(LocalPlayer.Character:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = true end
            end
        end
    end
end)


-- ==================== TAB 4: 🛡️ SAFETY & PLAYER (ตัวละครและความปลอดภัย) ====================

-- 🛡️ 11. อมตะ ป้องกันมอนสตี้/ผู้เล่นทำความเสียหาย + กันตัวละครแยกร่างตาย
local function EnableGodmodeProtection()
    local char = LocalPlayer.Character
    local hum = GetHum(LocalPlayer)

    if hum and char then
        hum.MaxHealth = math.huge
        hum.Health = math.huge
        hum.BreakJointsOnDeath = false

        hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)

        -- ล็อกข้อต่อกระดูก (Motor6D) ไม่ให้หลุดแยกร่างเวลารับความเสียหาย
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("Motor6D") then
                v.Enabled = true
            end
        end
    end
end

CreateToggleButton(TabSafe, "🛡️ 11. อมตะ ไม่มีวันตาย/ไม่แยกร่าง (Godmode)", function(e)
    GodmodeEnabled = e
    if GodmodeEnabled then
        EnableGodmodeProtection()

        if GodmodeConn then GodmodeConn:Disconnect() end
        GodmodeConn = RunService.Stepped:Connect(function()
            if GodmodeEnabled then
                EnableGodmodeProtection()
            end
        end)

        local currentHum = GetHum(LocalPlayer)
        if currentHum then
            if GodmodeHealthConn then GodmodeHealthConn:Disconnect() end
            GodmodeHealthConn = currentHum.HealthChanged:Connect(function()
                if GodmodeEnabled and currentHum then
                    currentHum.Health = math.huge
                end
            end)
        end
    else
        if GodmodeConn then GodmodeConn:Disconnect() GodmodeConn = nil end
        if GodmodeHealthConn then GodmodeHealthConn:Disconnect() GodmodeHealthConn = nil end

        local hum = GetHum(LocalPlayer)
        if hum then 
            hum.MaxHealth = 100
            hum.Health = 100
            hum.BreakJointsOnDeath = true
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
        end
    end
end)

CreateToggleButton(TabSafe, "🕳️ 13. ป้องกันตกแมพ (Anti-Void Return)", function(e)
    AntiVoidEnabled = e
    if AntiVoidEnabled then
        AntiVoidConn = RunService.Heartbeat:Connect(function()
            local hrp, hum = GetHRP(LocalPlayer), GetHum(LocalPlayer)
            if hrp and hum then
                if hum.FloorMaterial ~= Enum.Material.Air and hrp.Position.Y > (workspace.FallenPartsDestroyHeight + 20) then
                    LastSafeCF = hrp.CFrame
                end

                if hrp.Position.Y <= (workspace.FallenPartsDestroyHeight + 30) then
                    hum.Health = hum.MaxHealth
                    hrp.CFrame = LastSafeCF and (LastSafeCF + Vector3.new(0, 3, 0)) or CFrame.new(0, 50, 0)
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    hrp.RotVelocity = Vector3.new(0, 0, 0)
                end
            end
        end)
    else
        if AntiVoidConn then AntiVoidConn:Disconnect() AntiVoidConn = nil end
    end
end)

CreateActionButton(TabSafe, "💀 18. รีเซ็ตตัวละคร (Reset)", "กดรีเซ็ต", Theme.ButtonRed, function()
    local char, hum = LocalPlayer.Character, GetHum(LocalPlayer)
    if char and hum then
        hum.MaxHealth = 100
        hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
        hum.Health = 0
        char:BreakJoints()
    end
end)


-- Refresh Lists & Respawn Listeners
local function RefreshAll()
    if openJS and openJS() then refJS() end
    if openLF and openLF() then refLF() end
    if openLookAt and openLookAt() then refLookAt() end
    if openFling and openFling() then refFling() end
    if openBehind and openBehind() then refBehind() end
    if openBangRip and openBangRip() then refBangRip() end
    if openESP and openESP() then refESP() end
    if openOrbit and openOrbit() then refOrbit() end
end
Players.PlayerAdded:Connect(RefreshAll)
Players.PlayerRemoving:Connect(RefreshAll)

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if NoLegAnimEnabled then
        local anim = char:FindFirstChild("Animate")
        if anim then anim.Disabled = true end
    end
    if GodmodeEnabled then
        EnableGodmodeProtection()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if GodmodeHealthConn then GodmodeHealthConn:Disconnect() end
            GodmodeHealthConn = hum.HealthChanged:Connect(function()
                if GodmodeEnabled and hum then
                    hum.Health = math.huge
                end
            end)
        end
    end
end)

RunService.Stepped:Connect(function()
    local hum = GetHum(LocalPlayer)
    if hum and not AutoFollowEnabled then
        if WalkSpeedEnabled then
            if hum.WalkSpeed ~= WalkSpeedValue then
                hum.WalkSpeed = WalkSpeedValue
            end
        end
    end
end)
